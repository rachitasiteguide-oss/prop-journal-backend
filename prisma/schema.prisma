// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ─────────────────────────────────────────────────────────────────────

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  name      String?
  avatar    String?
  googleId  String? @unique
  password  String? // null for Google-only users

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  showOnLeaderboard Boolean @default(false)

  bio          String?
  phone        String?
  country      String?
  timezone     String?   @default("UTC")
  referralCode String?   @unique

  accounts         Account[]
  challenges       Challenge[]
  noteFolders      NoteFolder[]
  notes            Note[]
  strategies       Strategy[]
  routines         Routine[]
  backtestSessions BacktestSession[]

  @@map("users")
}

// ── Account ──────────────────────────────────────────────────────────────────
// Represents a trading account (live, demo, or prop firm account)

enum AccountType {
  LIVE
  DEMO
  PROP
}

model Account {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  broker      String?
  accountType AccountType @default(DEMO)
  balance     Float       @default(0)
  currency    String      @default("USD")
  isActive    Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trades     Trade[]
  importJobs ImportJob[]
  snapshots  DailySnapshot[]

  @@index([userId])
  @@map("accounts")
}

// ── Trade ─────────────────────────────────────────────────────────────────────

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

// Asset class — used for instrument-specific P&L normalisation and
// broker field mapping (e.g. lot sizes differ between FOREX and FUTURES).
enum InstrumentType {
  FOREX
  FUTURES
  STOCKS
  CRYPTO
  CFD
  OPTIONS
}

model Trade {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // ── Core execution ──────────────────────────────────────────────────────
  symbol         String
  instrumentType InstrumentType @default(FOREX)
  side           TradeSide
  entryPrice     Float
  exitPrice      Float?
  volume         Float          // lot size / quantity / contracts
  pnl            Float?         // realized P&L in account currency
  commission     Float?         @default(0)
  swap           Float?         @default(0)

  // ── Risk management ─────────────────────────────────────────────────────
  // Planned prices set before entry; used to compute R-multiple post-trade.
  // R = pnl / (abs(entryPrice - stopLoss) * volume)
  stopLoss   Float?
  takeProfit Float?

  // ── Strategy ────────────────────────────────────────────────────────────
  setup String? // named strategy, e.g. "Break & Retest", "Fair Value Gap"
  notes String?
  tags  String[] @default([])

  // ── Lifecycle ───────────────────────────────────────────────────────────
  status  TradeStatus @default(OPEN)
  entryAt DateTime
  exitAt  DateTime?

  // ── Ingestion ────────────────────────────────────────────────────────────
  // Broker-assigned trade ID; used as a deduplication key during CSV/API
  // imports so re-uploading the same file never creates duplicate rows.
  externalId  String?    // broker trade ID
  importJobId String?
  importJob   ImportJob? @relation(fields: [importJobId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite unique: one external ID per account (NULLs are always distinct
  // in PostgreSQL so manually-entered trades are unaffected).
  @@unique([accountId, externalId])
  @@index([accountId])
  @@index([status])
  @@index([entryAt])
  @@index([importJobId])
  @@map("trades")
}

// ── ImportJob ─────────────────────────────────────────────────────────────────
// Tracks a single CSV upload or broker API sync attempt.
// Gives users an audit trail and lets the UI show progress / errors.

enum ImportJobStatus {
  PENDING     // queued, not yet started
  PROCESSING  // actively parsing / inserting
  COMPLETED   // all rows inserted successfully
  PARTIAL     // some rows inserted; errors logged for the rest
  FAILED      // fatal error; no rows inserted
}

model ImportJob {
  id        String @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Which broker format / ingestion source.
  // e.g. "mt4", "mt5", "tradovate", "ninjatrader", "ibkr", "csv_generic"
  source   String
  fileName String? // original filename (CSV uploads only)

  status       ImportJobStatus @default(PENDING)
  rowsTotal    Int?            // null until file is parsed
  rowsImported Int             @default(0)

  // Structured error log: [{ row: number, message: string }]
  // Stored as JSON so we can surface per-row failures without extra tables.
  errors Json?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  trades Trade[]

  @@index([accountId])
  @@index([status])
  @@map("import_jobs")
}

// ── DailySnapshot ─────────────────────────────────────────────────────────────
// End-of-day equity record per account.
// Source of truth for:
//   - Equity curves
//   - Daily drawdown calculation (prop firm challenge compliance)
//   - Historical P&L aggregation without re-scanning every trade
//
// One row per (account, calendar date). Created/updated when a trading day closes
// or on demand via a recalculation job.

model DailySnapshot {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  date         DateTime @db.Date // calendar date; normalised to midnight UTC
  openBalance  Float             // account balance at start of day
  closeBalance Float             // account balance at end of day
  pnl          Float             // realised P&L for the day (closeBalance - openBalance + deposits - withdrawals)
  commissions  Float    @default(0) // total commissions paid that day
  tradeCount   Int      @default(0) // number of closed trades

  // Daily drawdown as a decimal fraction (0.05 = 5% drawdown).
  // Calculation: (openBalance - min_intraday_equity) / openBalance
  drawdown Float @default(0)

  createdAt DateTime @default(now())

  // One snapshot per account per day; safe to upsert.
  @@unique([accountId, date])
  @@index([accountId])
  @@map("daily_snapshots")
}

// ── Challenge ─────────────────────────────────────────────────────────────────
// Tracks a prop firm evaluation challenge

enum ChallengePhase {
  PHASE_1
  PHASE_2
  FUNDED
}

enum ChallengeStatus {
  ACTIVE
  PASSED
  FAILED
  WITHDRAWN
}

// ── Notebook ──────────────────────────────────────────────────────────────────

enum NoteType {
  NOTE
  TRADE_IDEA
  MARKET_ANALYSIS
  WEEKLY_REVIEW
  STRATEGY
}

enum NoteStatus {
  ACTIVE
  ARCHIVED
}

model NoteFolder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]

  @@index([userId])
  @@map("note_folders")
}

model Note {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId String?
  folder   NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  title   String
  content String     @default("")
  type    NoteType   @default(NOTE)
  status  NoteStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([folderId])
  @@map("notes")
}

// ── Strategy ──────────────────────────────────────────────────────────────────
// A named trading strategy/setup. Trades are linked by matching trade.setup === strategy.name.

model Strategy {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  color       String   @default("#6366f1")
  isDefault   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("strategies")
}

// ── Challenge ─────────────────────────────────────────────────────────────────
// Tracks a prop firm evaluation challenge

model Challenge {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firmName    String
  phase       ChallengePhase @default(PHASE_1)
  accountSize Float          // e.g. 100000 for $100k account
  currency    String         @default("USD")

  // Rules
  profitTarget   Float // e.g. 0.10 = 10%
  maxDrawdown    Float // e.g. 0.10 = 10% (overall)
  dailyDrawdown  Float // e.g. 0.05 = 5% (daily)
  minTradingDays Int   @default(0)

  startDate DateTime
  endDate   DateTime?

  status ChallengeStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("challenges")
}

// ── Routines ──────────────────────────────────────────────────────────────────
// Daily trading checklists (Pre-Market, During Trade, Post-Market, Custom)

enum RoutineType {
  PRE_MARKET
  DURING_TRADE
  POST_MARKET
  CUSTOM
}

model Routine {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  routineType RoutineType @default(CUSTOM)
  isDefault   Boolean     @default(false) // system-seeded defaults

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       RoutineItem[]
  completions RoutineCompletion[]

  @@index([userId])
  @@map("routines")
}

model RoutineItem {
  id        String  @id @default(cuid())
  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  text     String
  position Int    @default(0) // display order

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions RoutineItemCompletion[]

  @@index([routineId])
  @@map("routine_items")
}

// One record per (item, date) — toggled on/off each day
model RoutineItemCompletion {
  id            String      @id @default(cuid())
  routineItemId String
  routineItem   RoutineItem @relation(fields: [routineItemId], references: [id], onDelete: Cascade)

  date      DateTime @db.Date // calendar date normalised to midnight UTC
  completed Boolean  @default(true)

  @@unique([routineItemId, date])
  @@index([routineItemId])
  @@map("routine_item_completions")
}

// Aggregate per (routine, date) — tracks streak
model RoutineCompletion {
  id        String  @id @default(cuid())
  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  date           DateTime @db.Date
  totalItems     Int
  completedItems Int
  allDone        Boolean  @default(false)

  @@unique([routineId, date])
  @@index([routineId])
  @@map("routine_completions")
}

// ── Backtesting ────────────────────────────────────────────────────────────────

enum BacktestStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

// Whether the session was populated manually by the user or by the auto-engine.
enum BacktestMode {
  MANUAL
  AUTO
}

// Lifecycle of an automated backtest run.
enum RunStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
}

model BacktestSession {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  symbol          String
  instrumentType  String         @default("FOREX")
  startDate       DateTime
  endDate         DateTime
  startingBalance Float          @default(10000)
  currentBalance  Float          @default(10000)
  notes           String?
  status          BacktestStatus @default(ACTIVE)

  // ── Auto-run fields ──────────────────────────────────────────────────────
  mode            BacktestMode   @default(MANUAL)
  // Candle granularity used for the auto run: "D1", "H1", "M15", etc.
  timeframe       String?
  // Key into STRATEGY_CATALOG, e.g. "MA_CROSS", "RSI_REVERSAL".
  strategyType    String?
  // Full strategy + risk config JSON:
  //   { fastPeriod, slowPeriod, slippagePct, commission, stopLossPct,
  //     takeProfitRatio, riskPerTrade, volume, maxOpenPositions, ... }
  strategyConfig  Json?
  runStatus       RunStatus      @default(IDLE)
  runProgress     Int            @default(0)   // 0–100
  runError        String?
  runStartedAt    DateTime?
  runCompletedAt  DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  trades          BacktestTrade[]

  @@index([userId])
  @@map("backtest_sessions")
}

model BacktestTrade {
  id          String          @id @default(cuid())
  sessionId   String
  session     BacktestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  symbol      String
  side        TradeSide
  entryPrice  Float
  exitPrice   Float?
  volume      Float           @default(1)
  stopLoss    Float?
  takeProfit  Float?
  pnl         Float?          // net P&L after commission deduction
  pnlPct      Float?          // pnl / startingBalance × 100
  commission  Float           @default(0)  // per-trade commission applied at close
  slippage    Float           @default(0)  // slippage applied at entry (in price units)
  // True when both SL and TP were crossed on the same candle; SL takes priority.
  ambiguous   Boolean         @default(false)
  status      TradeStatus     @default(OPEN)
  entryAt     DateTime
  exitAt      DateTime?
  notes       String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([sessionId])
  @@map("backtest_trades")
}

// ── Market data cache ─────────────────────────────────────────────────────────
// OHLCV candles fetched from Yahoo Finance and stored locally.
// The composite unique on (symbol, timeframe, openTime) makes upserts safe
// and prevents duplicates across repeated fetches.

model Candle {
  id        String   @id @default(cuid())
  symbol    String
  // Timeframe code: "D1" | "W1" | "H1" | "H4" | "M30" | "M15" | "M5" | "M1"
  timeframe String
  openTime  DateTime // UTC open timestamp for the candle
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float    @default(0)

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe, openTime])
  @@map("candles")
}
